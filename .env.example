# Database Configuration
# PostgreSQL primary connection; if unavailable or table creation fails, falls back automatically to SQLite
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fin_sentiment_db
SQLITE_FALLBACK_URL=sqlite:///data/fin_sentiment.db

# Ingestion Settings
DEFAULT_TICKERS=NVDA,AAPL,MSFT,AMZN,GOOGL
MARKET_HISTORY_PERIOD=2y

# NLP Settings
FINBERT_MODEL_NAME=ProsusAI/finbert
DEVICE=cpu

# ML Model Parameters
TARGET_HORIZON_DAYS=5
TRAIN_TEST_SPLIT_RATIO=0.8
XGB_N_ESTIMATORS=100
XGB_LEARNING_RATE=0.05
XGB_MAX_DEPTH=4
